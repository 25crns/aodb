# Copy to ".env" and fill in. NEVER commit ".env".
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=airport_aodb

# Signs login cookies. Generate one:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Cloud database only (Aiven): path to the downloaded CA certificate, saved next to app.py
# DB_SSL_CA=ca.pem
